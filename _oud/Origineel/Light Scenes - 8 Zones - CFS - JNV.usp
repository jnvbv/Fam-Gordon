/*******************************************************************************************
  Event Handlers
  (Uncomment and declare additional event handlers as needed)
*******************************************************************************************/
push file_load
{
	FileLoad();

	UpdateFB();
}

push file_save
{
	FileSave();
}

push all_toggle
{
	if(!all_on_fb)	AllOn();
	else			AllOff();
}

push all_on
{
	AllOn();
}

push all_off
{
	AllOff();
}

push scene_toggle
{
	integer i;
	i = getlastmodifiedarrayindex();

	if(!scene_fb[i])	SceneOn(i);
	else				SceneOff(i);
}

push scene_on
{
	integer i;
	i = getlastmodifiedarrayindex();

	SceneOn(i);
}

push scene_off
{
	integer i;
	i = getlastmodifiedarrayindex();

	SceneOff(i);
}
 
push scene_store
{
	integer i;
	i = getlastmodifiedarrayindex();

	SceneStore(i);
}


push zone_toggle
{
	integer i;
	i = getlastmodifiedarrayindex();

	if(zone_off_fb[i])	ZoneOn(i);
	else				ZoneOff(i);
}

push zone_on
{
	integer i;
	i = getlastmodifiedarrayindex();

	ZoneOn(i);
}

push zone_off
{
	integer i;
	i = getlastmodifiedarrayindex();

	ZoneOff(i);
}

push zone_on_store
{
	integer i;
	i = getlastmodifiedarrayindex();

	ZoneOnStore(i);
}

change zone_level_in
{
	integer i;
	i = getlastmodifiedarrayindex();

	ZoneLevel(i);
}




/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/

Function Main()
{
	integer z, s;

	initialized = 0;

    WaitForInitializationComplete();

 	// Recall last zone levels from NVRAM
	for(z = 1 to NR_OF_ZONES)
	{
		if(zone_name$[z] = "")
			zone_not_used[z] = 1;
		else
			zone_not_used[z] = 0; 
		
		zone_level_out[z] = zone_current_level[z];
	}

	for(s = 1 to NR_OF_SCENES)
	{
		if(scene_name$[s] = "")
			scene_not_used[s] = 1;
		else
			scene_not_used[s] = 0; 
	}

	initialized = 1;

	UpdateFB();
}

