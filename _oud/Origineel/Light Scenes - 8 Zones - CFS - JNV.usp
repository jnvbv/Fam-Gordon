function FileLoad()
{
	signed_integer file_handle;
	integer s, z, err, level, pos;
	string file$[SIZE_MAX_FILE];
	
	StartFileOperations();

	file_handle = FileOpen(file_name$, _O_RDONLY | _O_TEXT) ;
	if(file_handle < 0)
	{
		GenerateUserError("ERROR: Light Scenes - CFS - JNV: Unable to open file: %s\n", file_name$);

		// If file not exsist, start off with some defaults
		for(s = 1 to NR_OF_SCENES)
		{
			for(z = 1 to NR_OF_ZONES)
			{
				level = 58981;	// 58981 = 90%
				scene_zone_level[s][z] = level;
			}
		}

		for(z = 1 to NR_OF_ZONES)
		{
			level = 58981;	// 58981 = 90%
			zone_on_level[z] = level;
		}
    }
    else
    {	
		print("NOTICE: Light Scenes - CFS - JNV: Reading File: %s\n", file_name$);
	     
		err = FileRead(file_handle, file$, SIZE_MAX_FILE);
		if(err < 0)
		{
			GenerateUserError("ERROR: Light Scenes - CFS - JNV: ReadString(%s) Error Code: %d\n", file$, err);
        }
		else
		{
			// Parse file
			pos = find("LIGHT_SCENE", file$);
			if(pos)
			{
				pos = pos + 13;

				// Scenes Zone Levels
				for(s = 1 to NR_OF_SCENES)
				{
					for(z = 1 to NR_OF_ZONES)
					{
						pos = find("SCENE_ZONE", file$, pos);
						if(pos)
						{
							pos = pos + 13;
							level = atoi(mid(file$, pos, SIZE_MAX_FILE));
							if(level <= MAX_LEVEL)	// >MAX_LEVEL means unaffected
								scene_zone_level[s][z] = level;						
							else
								scene_zone_level[s][z] = UNAFFECTED;						
						}	
					}
				}

				// Zone On Levels
				for(z = 1 to NR_OF_ZONES)
				{
					pos = find("ZONE_ON_LEVEL", file$, pos);
					if(pos)
					{
						pos = pos + 15;
						level = atoi(mid(file$, pos, SIZE_MAX_FILE));
						zone_on_level[z] = level;						
					}	
				}
			}
		}

    	err = FileClose(file_handle);
    	if(err)
			GenerateUserError("ERROR: Light Scenes - CFS - JNV: Unable to close file: %s (handle: %d)\n", file_name$, file_handle);
    }
      
	EndFileOperations();
}
 
 
function FileSave()
{
	signed_integer file_handle;
	integer s, z, err;
	string file$[SIZE_MAX_FILE];
		
	StartFileOperations();
	
	file_handle = FileOpen(file_name$, _O_WRONLY | _O_CREAT | _O_TRUNC | _O_TEXT) ;
	if(file_handle < 0)
	{
		GenerateUserError("ERROR: Light Scenes - CFS - JNV: Unable to open/create file: %s\n", file_name$);
   	}
   	else
   	{
		print("NOTICE: Light Scenes - CFS - JNV: Saving File: %s\n", file_name$);

		file$ = "\n";

		// Scenes Zone Levels
		for(s = 1 to NR_OF_SCENES)
		{
			file$ = file$ + "LIGHT_SCENE" + itoa(s) + ":\n";

			for(z = 1 to NR_OF_ZONES)
			{
				if(scene_zone_level[s][z] <= MAX_LEVEL)	// >MAX_LEVEL means unaffected
					file$	= file$ + "  SCENE_ZONE" + itoa(z) + ": " + itoa(scene_zone_level[s][z]) + "\n";
				else
					file$	= file$ + "  SCENE_ZONE" + itoa(z) + ": " + itoa(UNAFFECTED) + "\n";
			}
		}

		file$ = file$ + "\n";

		// Zone On Levels
		for(z = 1 to NR_OF_ZONES)
		{
			file$ = file$ + "ZONE_ON_LEVEL" + itoa(z) + ": " + itoa(zone_on_level[z]) + "\n";
		}

		file$ = file$ + "\n[65534=100%, 58981=90%, 49151=75%, 32767=50%, 16383=25% >65534=Unaffected]";
			     
		err = FileWrite(file_handle, file$, len(file$));
		if(err < 0)
			GenerateUserError("ERROR: Light Scenes - CFS - JNV: WriteString(%s) Error Code: %d\n", file$, err);

   		err = FileClose(file_handle);
   		if(err)
			GenerateUserError("ERROR: Light Scenes - CFS - JNV: Unable to close file: %s (handle: %d)\n", file_name$, file_handle);
    }
      
	EndFileOperations();
}


function UpdateFB()
{
	integer z, s, zones_on, zones_match;
    
	//
	// Update Zone FB
	//
	zones_on = 0;	
	for(z = 1 to NR_OF_ZONES)
	{
		// Store current level in NVRAM
		zone_current_level[z] = zone_level_out[z];

		if((zone_level_out[z] > 0) && (zone_not_used[z] = 0))	
		{
			zone_off_fb[z]	= 0;
			zone_on_fb[z]	= 1;
            
			zones_on		= 1;
		}
		else
		{
			zone_on_fb[z]	= 0;
			zone_off_fb[z]	= 1;
		}
    }    

	//
	// Update All On/Off FB
	//
	if(zones_on)
	{
		all_off_fb = 0;
		all_on_fb = 1;
	}
	else
	{
		all_on_fb = 0;
		all_off_fb = 1;
	}

    //
	// Update Scene FB
	//
	for(s = 1 to NR_OF_SCENES)
	{
		for(z = 1 to NR_OF_ZONES)
		{
			if((scene_zone_level[s][z] > MAX_LEVEL) || (zone_not_used[z] = 1))	// >MAX_LEVEL means unaffected
    		{
				zones_match = 1;
			}
			else
			{
				if(zone_level_out[z] = scene_zone_level[s][z])
				{
					zones_match = 1;
				}
				else
				{
					zones_match = 0;
					break;
				}
			}
		}
		
		if(zones_match)	scene_fb[s] = 1;
		else			scene_fb[s] = 0;
	}
}
   

function AllOn()
{
	integer z;

	for(z = 1 to NR_OF_ZONES)
	{
		zone_ramp_fb[z] = 1;
    	zone_level_out[z] = MAX_LEVEL;
		zone_ramp_fb[z] = 0;
	}

	UpdateFB();
}


function AllOff()
{
	integer z;

	for(z = 1 to NR_OF_ZONES)
	{
		zone_ramp_fb[z] = 1;
    	zone_level_out[z] = 0;
		zone_ramp_fb[z] = 0;
	}

	UpdateFB();
}


function SceneOn(integer s)
{
	integer z;

	for(z = 1 to NR_OF_ZONES)
	{
		if(scene_zone_level[s][z] <= MAX_LEVEL)	// >MAX_LEVEL means unaffected
		{
			zone_ramp_fb[z] = 1;
	    	zone_level_out[z] = scene_zone_level[s][z];
			zone_ramp_fb[z] = 0;
		}
	}

	UpdateFB();
}
   

function SceneOff(integer s)
{
	integer z;

	for(z = 1 to NR_OF_ZONES)
	{
		if(scene_zone_level[s][z] <= MAX_LEVEL)	// >MAX_LEVEL means unaffected
		{
			zone_ramp_fb[z] = 1;
	    	zone_level_out[z] = 0;
			zone_ramp_fb[z] = 0;
		}
	}

	UpdateFB();
}


function SceneStore(integer s)
{
	integer z;

	for(z = 1 to NR_OF_ZONES)
	{
		scene_zone_level[s][z] = zone_level_out[z];
	} 	

	UpdateFB();
}


function ZoneOn(integer z)
{
	zone_ramp_fb[z] = 1;
	zone_level_out[z] = zone_on_level[z];
	zone_ramp_fb[z] = 0;

	UpdateFB();
}
 

function ZoneOff(integer z)
{
	zone_ramp_fb[z] = 1;
	zone_level_out[z] = 0;
	zone_ramp_fb[z] = 0;

	UpdateFB();
}


function ZoneOnStore(integer z)
{
	zone_on_level[z] = zone_level_out[z];
}


function ZoneLevel(integer z)
{
	integer d;
	
	// Avoid startup problems initializing
	if(initialized)
	{
