// TCP_CLIENT
// TCP_SERVER
// UDP_SOCKET

/*******************************************************************************************
  Parameters
  (Uncomment and declare parameters as needed)
*******************************************************************************************/
INTEGER_PARAMETER	setpoint_min, setpoint_max, setpoint_default, setpoint_increment, hysteresis;
STRING_PARAMETER	file_name$[SIZE_OF_FILENAME];


