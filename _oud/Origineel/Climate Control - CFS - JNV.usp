// INPUTS
DIGITAL_INPUT 	_SKIP_, _SKIP_, _SKIP_, _SKIP_, _SKIP_, _SKIP_,
				file_load,
				file_save,
				zone_setpoint_up[NR_OF_ZONES],
				zone_setpoint_down[NR_OF_ZONES];

ANALOG_INPUT	zone_setpoint_in[NR_OF_ZONES],
				zone_temperature_in[NR_OF_ZONES];

// OUTPUTS
DIGITAL_OUTPUT	_SKIP_, _SKIP_, _SKIP_, _SKIP_, _SKIP_, _SKIP_,
				setpoints_changed, _SKIP_,
				zone_on_fb[NR_OF_ZONES],
				zone_off_fb[NR_OF_ZONES];

ANALOG_OUTPUT	zone_setpoint_fb[NR_OF_ZONES];

