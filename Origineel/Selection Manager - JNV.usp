/*******************************************************************************************
  Compiler Directives
  (Uncomment and declare compiler directives as needed)
*******************************************************************************************/
#SYMBOL_NAME "Selection Manager - JNV"
#HINT "Selection Manager for Rooms, Function & Sources - JNV"
#CATEGORY "46" "JNV" // Custom

#DEFAULT_NONVOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

#DEFINE_CONSTANT	MAX_SEL					24
#DEFINE_CONSTANT	MAX_ITEMS_PER_PAGE		16
#DEFINE_CONSTANT	MAX_TEXT_LEN			50

#HELP_BEGIN

#HELP_END


/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
DIGITAL_INPUT enable, page_start, page_up, page_down;
DIGITAL_INPUT _SKIP_;
DIGITAL_INPUT item_select[MAX_ITEMS_PER_PAGE];

DIGITAL_INPUT _SKIP_;
DIGITAL_INPUT sel_enable[MAX_SEL];

DIGITAL_INPUT _SKIP_;
DIGITAL_INPUT sel_select[MAX_SEL]; 

// ANALOG INPUTS
ANALOG_INPUT _SKIP_;
ANALOG_INPUT items_per_page;

ANALOG_INPUT _SKIP_;
ANALOG_INPUT values[MAX_SEL];

STRING_INPUT _SKIP_;
STRING_INPUT texts$[MAX_SEL][MAX_TEXT_LEN];


// DIGITAL OUTPUTS            
DIGITAL_OUTPUT page_up_available, page_down_available;  

DIGITAL_OUTPUT _SKIP_;
DIGITAL_OUTPUT sel_pulse[MAX_SEL];
     
      
// ANALOG OUTPUTS      
ANALOG_OUTPUT _SKIP_;
ANALOG_OUTPUT sel_value;

// STRING OUTPUTS      
STRING_OUTPUT _SKIP_;      
STRING_OUTPUT sel_text$;

// ANALOG OUTPUTS ARRAY     
ANALOG_OUTPUT _SKIP_;
ANALOG_OUTPUT item_value[MAX_ITEMS_PER_PAGE];
  
      
// STRING OUTPUTS ARRY      
STRING_OUTPUT _SKIP_;      
STRING_OUTPUT item_text$[MAX_ITEMS_PER_PAGE];


/*******************************************************************************************
  Parameters
  (Uncomment and declare parameters as needed)
*******************************************************************************************/



/*******************************************************************************************
  Global Variables
  (Uncomment and declare global variables as needed)
  Note:  Be sure to initialize all declared STRING variables as needed
         For example, in Function Main: myString = "";
*******************************************************************************************/
integer	current_page, max_page_nr, current_selection, nr_of_sel, sel_enable_updating_busy;

integer	sel_enabled_number[MAX_SEL];

/*******************************************************************************************
  Functions
  (Add any additional functions here)
  Note:  Functions must be physically placed before the location in
         the code that calls them.
*******************************************************************************************/
function UpdateEnabledSelections()
{
	integer i, cnt;
	              
	cnt = 0;	              
	for(i = 1 to MAX_SEL)
	{
		if(sel_enable[i] = 1)
		{   
			// Count how many selection are enabled
			cnt = cnt + 1;

			// Remember which selectiona are enabled
			sel_enabled_number[cnt] = i;			
		}
	}                     	
	nr_of_sel = cnt; 
	
	// Calculatie maximum page number 
	max_page_nr = nr_of_sel / items_per_page;
	if((nr_of_sel - (max_page_nr * items_per_page)) > 0)
		max_page_nr = max_page_nr + 1;
}


function UpdateSelectionFeedback(integer sel)
{                      
	// Store current selection   
	current_selection = sel;	                                  
	                                  
	// Update value of the selection
	sel_value = values[sel];	                       
	                       
	// Update text of the selection
	sel_text$ = texts$[sel];	                       

	// Logic Wave the selection
	sel_pulse[sel] = 1;
	sel_pulse[sel] = 0;	
} 


function UpdatePageFeedback()
{
	integer i, sel, first;
	                      
	// Calculate the first item on the page
	first = (current_page - 1) * items_per_page + 1;   

	// Update item values and text 
	for(i = 0 to (items_per_page - 1))
	{   
		// Get the number of the enabled selection
		sel = sel_enabled_number[first + i];
				                                             
		if((first + i) <= nr_of_sel)
		{
			item_value[i + 1] = values[sel];
			item_text$[i + 1] = texts$[sel]; 						
		}
		else
		{
			item_value[i + 1] = 0;
			item_text$[i + 1] = ""; 						
		}		
	}
          
    // Update feedback of up/down available status
	if(current_page < max_page_nr)
		page_up_available = 1;
	else
		page_up_available = 0;
    
	if(current_page > 1)
		page_down_available = 1;
	else
		page_down_available = 0;
}
 
 
/*******************************************************************************************
  Event Handlers
  (Uncomment and declare additional event handlers as needed)
*******************************************************************************************/

push enable
{
	UpdateEnabledSelections();

	current_page = 1; 
	
/*
	// Catch in case the current selection was invalid
	if(current_selection > nr_of_sel)
	{
		current_selection = sel_enabled_number[1];                         
	} 
	
    UpdateSelectionFeedback(current_selection);   
*/    
    UpdatePageFeedback();
}

push page_start
{
	if(enable)
	{
		// Goto first page
	    current_page = 1;
	    UpdatePageFeedback();         
	}
}

change items_per_page
{
	if(enable)
	{
		// Goto first page to avoid problems
	    current_page = 1;
	    UpdatePageFeedback();     
	}	    
}

push page_up
{                                         
	if(enable)
	{
		// Check if there are more pages to show, if so increment page
	   	if(current_page < max_page_nr)
		    current_page = current_page + 1;
		    		
    	UpdatePageFeedback();
	}
}

push page_down
{
	if(enable)
	{
		// Check if we are already on the first page, if not decrement page
	    if(current_page > 1)
	    	current_page = current_page - 1;
	    	
	    UpdatePageFeedback();
	}
}
   
push item_select
{                               
	integer i, sel, first;

	if(enable)
	{	
		// Get pressed item number
		i = getlastModifiedArrayIndex();
		
		// Calculate the first item on the page
		first = (current_page - 1) * items_per_page + 1;   
	
		if((first + i - 1) <= nr_of_sel)
		{
			// Get the number of the enabled selection
			sel = sel_enabled_number[first + i - 1];
	
			// Update feedback of the current the selection
			UpdateSelectionFeedback(sel);	                                  
		}
	} 
}

push sel_select 
{
	integer sel;
	
	if(enable)
	{
		// Get pressed selection number
		sel = getlastModifiedArrayIndex();
		
		// Update feedback of the current the selection
		UpdateSelectionFeedback(sel);	                                  
	}
}

change sel_enable
{
	if(enable)
	{   
		if(!sel_enable_updating_busy)
		{   
			sel_enable_updating_busy = 1;

			// Give it al little time to settle all sel_enable, before we go updating 
			wait(10)
			{
				UpdateEnabledSelections();   
								
				// Goto first page to avoid problems
			    current_page = 1;
	    		UpdatePageFeedback();

				sel_enable_updating_busy = 0;  
			}   
		}
	}
}


/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/
function Main()
{
	integer i;

	current_page = 1;
	max_page_nr = 1;
	current_selection = 1;
	nr_of_sel = 1;
	
	sel_enable_updating_busy = 0;

	for(i = 1 to MAX_SEL)
	{
		sel_enabled_number[i] = 0;
	}

	WaitForInitializationComplete();
}


