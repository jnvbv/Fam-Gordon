/*******************************************************************************************
  Compiler Directives
*******************************************************************************************/
#SYMBOL_NAME "SWAMP Room Control - JNV"
// #HINT ""
#CATEGORY "46" "JNV" // Custom
// #DEFAULT_VOLATILE
// #DIGITAL_EXPAND	 
// #ANALOG_SERIAL_EXPAND 
// #OUTPUT_SHIFT 
#DEFAULT_NONVOLATILE
#ENABLE_STACK_CHECKING
/*
#HELP_BEGIN
   (add additional lines of help lines)
#HELP_END
*/


/*******************************************************************************************
  Include Libraries
*******************************************************************************************/


/*******************************************************************************************
  Definitions
*******************************************************************************************/

#DEFINE_CONSTANT	MAX_SOURCE			24

#DEFINE_CONSTANT	AUTO_ON_DELAY		10

#DEFINE_CONSTANT	VOL_OSC_TIME		15	
#DEFINE_CONSTANT	BASS_OSC_TIME		20	
#DEFINE_CONSTANT	TREBLE_OSC_TIME		20
#DEFINE_CONSTANT	BALANCE_OSC_TIME	20	
 
/*******************************************************************************************
  Structure Definitions
*******************************************************************************************/

STRUCTURE STRUCT_Room
{
	INTEGER amp, mute, mono, loudness;
	INTEGER vol, source;
	SIGNED_INTEGER bass, treble, balance;
};

STRUCT_Room room;


/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
*******************************************************************************************/
DIGITAL_INPUT init, norm;	// 'norm' sets bass, treble, balance to 0dB and loudness, mute off
DIGITAL_INPUT amp, amp_on, amp_off; 
DIGITAL_INPUT mute, mute_on, mute_off; 
DIGITAL_INPUT mono, mono_on, mono_off; 
DIGITAL_INPUT loudness, loudness_on, loudness_off; 
DIGITAL_INPUT vol_up, vol_down; 		// 0 ~ 65535	= 0% ~ 100%
DIGITAL_INPUT bass_up, bass_down;		// -120 ~ +120	= -12dB ~ +12dB
DIGITAL_INPUT treble_up, treble_down;	// -120 ~ +120	= -12dB ~ +12dB
DIGITAL_INPUT balance_up, balance_down; // 0 ~ 65535	= -50% (Left) ~ 0% (Center) ~ +50% (Right)
DIGITAL_INPUT source_none, source[MAX_SOURCE];      

ANALOG_INPUT vol, bass, treble, balance, source_ana, startup_vol;
 
 
DIGITAL_OUTPUT amp_on_fb, amp_off_fb, mute_on_fb, mute_off_fb, mono_on_fb, mono_off_fb, loudness_on_fb, loudness_off_fb;
DIGITAL_OUTPUT source_none_fb, source_fb[MAX_SOURCE];                      

ANALOG_OUTPUT vol_fb, bass_fb, treble_fb, balance_fb, source_ana_fb;


/*******************************************************************************************
  Global Variables
*******************************************************************************************/
  
NONVOLATILE INTEGER	validated, last_source;
      
      
/*******************************************************************************************
  Functions
*******************************************************************************************/

integer_function Validate()
{
	integer r;
	
	r = 0;

	if(!((room.amp 		>= 0) && (room.amp 		<= 1))) r = 1;
	if(!((room.mute 	>= 0) && (room.mute 	<= 1))) r = 2;
	if(!((room.mono 	>= 0) && (room.mono 	<= 1))) r = 3;
	if(!((room.loudness	>= 0) && (room.loudness	<= 1))) r = 4;

	if(!((room.vol		>= 0)		&& (room.vol		<= 65535)))			r = 5;
	if(!((room.bass		>= -120)	&& (room.bass		<= 120)))			r = 6;
	if(!((room.treble	>= -120)	&& (room.treble		<= 120)))			r = 7;
	if(!((room.balance	>= -32768)	&& (room.balance	<= 32768)))			r = 8;
	if(!((room.source	>= 0)		&& (room.source		<= MAX_SOURCE)))	r = 9;
	                                                                     
	return(r);
}

function Initialise()
{
	room.amp		= 0;
	room.mute		= 0;
	room.mono		= 0;
	room.loudness	= 0;
	room.vol		= 22938;	// 35%
	room.bass		= 0;		// 0dB
	room.treble		= 0;		// 0dB
	room.balance	= 0;		// Center
	room.source		= 0;

	last_source 	= 0;
}

function Normalise()
{
	room.mute		= 0;
	room.loudness	= 0;
	
	room.bass		= 0;	// 0dB
	room.treble		= 0;	// 0dB
	room.balance	= 0;	// Center

	bass_fb			= room.bass;
	treble_fb		= room.treble;
	balance_fb		= room.balance;

	mute_on_fb		= room.mute;
	mute_off_fb		= !room.mute;

	loudness_on_fb	= room.loudness;
	loudness_off_fb	= !room.loudness;
}

function SetSourceFeedback()
{      
	integer i;
	
	if(room.source > MAX_SOURCE)
	{
		print("ERROR: SWAMP Room Control - JNV, source exceeded MAX_SOURCE (%d), forced to %d\n\n", MAX_SOURCE, MAX_SOURCE);	
		room.source = MAX_SOURCE;
	}
		
	source_none_fb = 0;	

	for(i = 1 to MAX_SOURCE)
		source_fb[i] = 0;  

	ProcessLogic();	
	
	if(room.source = 0)
		source_none_fb = 1;	
	else
		source_fb[room.source] = 1;

	source_ana_fb = room.source;

	if(validated && (room.source <> 0))
	{
		Delay(AUTO_ON_DELAY);	
	 	
	 	room.amp	= 1;
	 	room.mute	= 0;		

		amp_on_fb	= room.amp;
		amp_off_fb	= !room.amp;
		
		mute_on_fb	= room.mute;
		mute_off_fb	= !room.mute;
	}
}

function SetFeedback()
{
	amp_on_fb 		= room.amp;
	amp_off_fb		= !room.amp;
	
	mute_on_fb 		= room.mute;
	mute_off_fb		= !room.mute;
	
	mono_on_fb 		= room.mono;
	mono_off_fb		= !room.mono;
	
	loudness_on_fb 	= room.loudness;
	loudness_off_fb	= !room.loudness;
	
	vol_fb			= room.vol;
	bass_fb			= room.bass;
	treble_fb		= room.treble;
	balance_fb		= room.balance;
	
	call SetSourceFeedback();
}

/*******************************************************************************************
  Event Handlers
*******************************************************************************************/

push init
{
	call Initialise();
	call SetFeedback();
}

push norm
{
	call Normalise();
}

push amp, amp_on, amp_off
{
	if(amp) 			room.amp = !room.amp;
	else if(amp_on) 	room.amp = 1;
	else if(amp_off) 	room.amp = 0;
	
	amp_on_fb		= room.amp;
	amp_off_fb		= !room.amp;
    
	if(room.amp)
	{
		room.source = last_source;	// Restore last selected source, which was selected before we switched off
	}
	else
	{
		if(room.source <> 0)
		{
			last_source = room.source;	// Remember the selected source before switching off
		}
		room.source = 0;
    }

	call SetSourceFeedback();
}

push mute, mute_on, mute_off
{
	if(mute) 			room.mute = !room.mute;
	else if(mute_on) 	room.mute = 1;
	else if(mute_off) 	room.mute = 0;
	
	mute_on_fb		= room.mute;
	mute_off_fb		= !room.mute;
}

push mono, mono_on, mono_off
{
	if(mono) 			room.mono = !room.mono;
	else if(mono_on) 	room.mono = 1;
	else if(mono_off) 	room.mono = 0;
	
	mono_on_fb		= room.mono;
	mono_off_fb		= !room.mono;
}

push loudness, loudness_on, loudness_off
{
	if(loudness) 			room.loudness = !room.loudness;
	else if(loudness_on) 	room.loudness = 1;
	else if(loudness_off) 	room.loudness = 0;
	
	loudness_on_fb	= room.loudness;
	loudness_off_fb	= !room.loudness;
}

push vol_up
{
	integer n;
	
	n = room.vol / 1024;	// Get in sync with steps (after direct value set)
	room.vol = 1024 * n;

	while(vol_up)
	{
		if(room.vol <= (65536 - 1024))
		{
			if(room.vol >= (63 * 1024))
				room.vol = 65535;			// last step to max
			else
				room.vol = room.vol + 1024;
			vol_fb = room.vol;
		}
		delay(VOL_OSC_TIME);
	}
}

push vol_down
{
	integer n;

	n = room.vol / 1024;	// Get in sync with steps (after direct value set)
	room.vol = 1024 * n;
	
	while(vol_down)
	{
		if(room.vol >= (0 + 1024))
		{
			if(room.vol > (63 * 1024))
				room.vol = 65535 - 1023;	// last step max - 1023
			else
				room.vol = room.vol - 1024;
			vol_fb = room.vol;
		}
		delay(VOL_OSC_TIME);
	}
}

push bass_up
{
	signed_integer n;
	
	n = room.bass S/ 10;	// Get in sync with steps (after direct value set)
	room.bass = 10 * n;
                        
	while(bass_up)
	{
		if(room.bass < 120)
		{
			room.bass = room.bass + 10;
			bass_fb = room.bass;
		}
		delay(BASS_OSC_TIME);
	}
}

push bass_down
{
	signed_integer n;
	
	n = room.bass S/ 10;	// Get in sync with steps (after direct value set)
	room.bass = 10 * n;
                        
	while(bass_down)
	{
		if(room.bass > -120)
		{
			room.bass = room.bass - 10;
			bass_fb = room.bass;
		}
		delay(BASS_OSC_TIME);
	}
}


push treble_up
{
	signed_integer n;
	
	n = room.treble S/ 10;	// Get in sync with steps (after direct value set)
	room.treble = 10 * n;

	while(treble_up)
	{
		if(room.treble < 120)
		{
			room.treble = room.treble + 10;
			treble_fb = room.treble;
		}
		delay(TREBLE_OSC_TIME);
	}
}

push treble_down
{
	signed_integer n;
	
	n = room.treble S/ 10;	// Get in sync with steps (after direct value set)
	room.treble = 10 * n;

	while(treble_down)
	{
		if(room.treble > -120)
		{
			room.treble = room.treble - 10;
			treble_fb = room.treble;
		}
		delay(TREBLE_OSC_TIME);
	}

}

push balance_up
{
	signed_integer n;
	
	n = room.balance S/ 1024;	// Get in sync with steps (after direct value set)
	room.balance = 1024 * n;

	while(balance_up)
	{
		if(room.balance < 31744)
		{
			room.balance = room.balance + 1024;
			balance_fb = room.balance;
		}
		delay(BALANCE_OSC_TIME);
	}
}

push balance_down
{
	signed_integer n;
	
	n = room.balance S/ 1024;	// Get in sync with steps (after direct value set)
	room.balance = 1024 * n;

	while(balance_down)
	{
		if(room.balance > -32767)
		{
			room.balance = room.balance - 1024;
			balance_fb = room.balance;
		}
		delay(BALANCE_OSC_TIME);
	}
}

push source_none
{
	room.source = 0;	

	room.vol = startup_vol;		// Set the startup volume
	vol_fb = room.vol;

	call SetSourceFeedback();
}

push source
{
	if(room.source = 0)
	{
		room.vol = startup_vol;		// Set the startup volume if we came from the off state
		vol_fb = room.vol;
	}

	room.source = GetLastModifiedArrayIndex();	
	call SetSourceFeedback();
}

change vol
{
	if(validated)
	{
		room.vol = vol;
		vol_fb = room.vol;
}   }

change bass
{  
	if(validated)
	{
		room.bass = bass;
		bass_fb = room.bass;
	}
}

change treble
{
	if(validated)
	{
		room.treble = treble;
		treble_fb = room.treble;
	}
}

change balance
{
	if(validated)
	{
		room.balance = balance;
		balance_fb = room.balance;
	}
}

change source_ana
{
	if(validated)
	{
		if(room.source = 0)
		{
			room.vol = startup_vol;		// Set the startup volume if we came from the off state
			vol_fb = room.vol;
		}

		room.source = source_ana;				
		call SetSourceFeedback();
	}
}
 


/*******************************************************************************************
  Main()
*******************************************************************************************/
function Main()
{ 
	validated = 0;

	if(Validate())
		Initialise();    
	             
	WaitForInitializationComplete();
                  
	call SetFeedback();

	validated = 1;
}


